# Supabase PostgreSQL 연결 문자열
# 프로젝트 상단 바의 Connect 버튼 > ORM 탭 > Prisma > .env.local 탭에서 복사합니다.
# [YOUR-PASSWORD] 자리는 프로젝트를 만들 때 정한 DB 비밀번호로 바꿉니다.
# 같은 풀러 호스트에서 DATABASE_URL 은 6543(pgbouncer=true), DIRECT_URL 은 5432 포트를 사용합니다.

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth
# URL: 프로젝트 홈 이름 아래 주소 또는 Integrations > Data API > Overview 의 API URL(끝의 /rest/v1/ 제외)
# anon 키: Project Settings > API Keys 의 Legacy anon public 키. service_role 키는 사용하지 않습니다.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
